# Environment variables for local development with direnv
# Run: direnv allow
export SERVER_ADDR=":8080"
export SERVER_READ_TIMEOUT_SECONDS="5"
export SERVER_WRITE_TIMEOUT_SECONDS="10"
export SERVER_IDLE_TIMEOUT_SECONDS="120"

# PostgreSQL Database Configuration
export DB_URL="postgres://postgres:password@localhost:5433/golearning?sslmode=disable"
export DB_MAX_CONNS="10"
export DB_MIN_CONNS="2"
export DB_MAX_CONN_IDLE_TIME_SECONDS="900"
export DB_MAX_CONN_LIFETIME_SECONDS="3600"
